# Copy to server.env on the server and fill in. Never commit server.env.

# The domain goes in deploy/.env (GARMIN_DOMAIN); this file holds the secrets.

# Dashboard password hash. Create it with: python -m garmin_ai.auth hash-password
GARMIN_APP_PASSWORD_HASH=

# Claude API key for AI insights (console.anthropic.com; set a monthly spend limit there)
ANTHROPIC_API_KEY=
# Optional; empty uses claude-opus-5-5
AI_MODEL=

# Garmin's official Personal API key, for the MCP server's live garmin_* tools
GARMIN_PERSONAL_API_KEY=

# Hevy API key (Hevy Pro: hevy.com > Settings > Developer). Optional; adds lifting data
# to every sync and to /api/strength.
HEVY_API_KEY=
# Unit you log Hevy weights in, kg or lb. Empty detects it from the logged weights.
HEVY_WEIGHT_UNIT=

# Background sync while the server runs
GARMIN_AUTO_SYNC_INTERVAL_MIN=120
GARMIN_AUTO_SYNC_DAYS=7

# Automatic weekly review (weekday and 24 h time, or off) and the time zone for it
GARMIN_WEEKLY_REVIEW=sun 19:00
GARMIN_TIMEZONE=America/Toronto
