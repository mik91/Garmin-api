# Everything here is optional: the web app's Connections page can set it up instead.
# Official Garmin Personal API key (Garmin Connect > account settings > Personal API).
# Used by the MCP server's live garmin_* tools.
GARMIN_PERSONAL_API_KEY=

# Hevy API key (Hevy Pro: Settings > Developer). Optional; syncs lifting workouts.
HEVY_API_KEY=
# Unit your Hevy weights are logged in (kg or lb); empty detects it
HEVY_WEIGHT_UNIT=

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password
# AI insights use your logged-in Claude Code or Codex CLI (no API key needed)
AI_PROVIDER=claude

# Optional
# Model passed to the CLI; leave empty for the CLI's default
AI_MODEL=
# Command or full path, if the CLI is not on PATH
CLAUDE_CLI=claude
CODEX_CLI=codex
AI_CLI_TIMEOUT_S=300
GARMIN_TOKENSTORE=.garmin_tokens
GARMIN_DB_PATH=data/garmin.db
GARMIN_WEB_PORT=8502
GARMIN_AUTO_SYNC_ON_STARTUP=true
GARMIN_AUTO_SYNC_DAYS=7
# Minutes between background syncs while the web app runs; 0 = off
GARMIN_AUTO_SYNC_INTERVAL_MIN=60
